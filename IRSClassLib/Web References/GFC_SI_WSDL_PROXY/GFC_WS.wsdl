    </wsdl:operation>
    <wsdl:operation name="PurchaseGFC">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Service to get account and enroll customer to GFC and RM.&lt;BR&gt;Service Return = Status Code|RMNumber|Account Number|Card Number|BaseTraceNo|Remarks/Error&lt;br&gt;SystemSource* = Source system&lt;br&gt;BranchCode* = Issuing branch (5760 / S000)&lt;br&gt;SubBranch = Issuing sub branch&lt;br&gt;Lname* = Last name&lt;br&gt;Fname* = First Name&lt;br&gt;Mname = Middle Name &lt;br&gt;Birthday* = Date of birth (01-01-1995)&lt;br&gt;Country* = Issuing Country (JAPAN)&lt;br&gt;Nationality = Country nationality (PHILIPPINES)&lt;br&gt;Address1* = Address 1 &lt;br&gt;Address2 = Address 2&lt;br&gt;Address3 = Address 3&lt;br&gt;City* = City &lt;br&gt;Province* = Province &lt;br&gt;Region* = Region &lt;br&gt;ZipCode* = Numeric zip code &lt;br&gt;TelNo* = Telephone number &lt;br&gt;MobileCountry* = Mobile Country &lt;br&gt;MobileNo* = CP number &lt;br&gt;EMail* = eMail Address &lt;br&gt;CurrCode* = GFC currency code (PHP/USD)&lt;br&gt;CardNo* = GFC card number (5921080412345678)&lt;br&gt;IDPres* = ID number (12345679)&lt;br&gt;IDType* = Require ID type&lt;br&gt;EmployerName = Employer name&lt;br&gt;Occupation = Occupation&lt;br&gt;FromSourceOfFundCountry* = Country where remittance will originate (JAPAN)&lt;br&gt;Group = GFC Group (PDOS)&lt;br&gt;RMNumber = RM Number of customer (if available)&lt;br&gt;IRSRemID = IRSW / ARS remitter I.D.&lt;br&gt;UserID = For IRSW, send IRS only.  For ARS, send user I.D.</wsdl:documentation>
      <wsdl:input message="tns:PurchaseGFCSoapIn" />
      <wsdl:output message="tns:PurchaseGFCSoapOut" />
    </wsdl:operation>
